# PRODUCTION: replace with a public DNS name that points to the server.
DOMAIN=notes.example.com

# PRODUCTION: choose these values before the PostgreSQL volume is created.
POSTGRES_USER=cloud_notes
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=cloud_notes

# PRODUCTION: generate with `openssl rand -hex 32` and keep it unchanged.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long

# PRODUCTION: 43200 minutes and 2592000 seconds both equal 30 days.
# Set JWT_EXPIRE_MINUTES=0 only when deliberately choosing non-expiring tokens.
JWT_EXPIRE_MINUTES=43200
SESSION_MAX_AGE_SECONDS=2592000

# Keep true when Caddy provides HTTPS. Set false only for local HTTP development.
COOKIE_SECURE=true

# PRODUCTION: disable after creating the required user accounts if appropriate.
REGISTRATION_ENABLED=true

# Keep false unless temporary SQL debugging is explicitly required.
SQL_ECHO=false
